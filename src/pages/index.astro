---
const siteUrl = "https://akshay-portfolio.vercel.app";
const title = "Akshay Mhatre - Frontend Developer";
const description =
  "Akshay Mhatre is a frontend developer focused on digital banking, building features across retail, business, and wealth management with Angular and the Backbase AI-powered banking platform.";
const ogImage = `${siteUrl}/portfolio-screenshot.png`;

const highlights = [
  { value: "Angular", label: "Primary frontend stack" },
  { value: "Backbase", label: "Certified banking platform" },
  { value: "3 domains", label: "Retail, business, wealth" },
];

const capabilities = [
  {
    title: "Banking journeys",
    text: "Builds customer-facing flows across onboarding, servicing, account access, and lifecycle moments.",
  },
  {
    title: "Platform delivery",
    text: "Works inside Backbase ecosystems where feature work needs to respect platform contracts and release pace.",
  },
  {
    title: "Frontend systems",
    text: "Turns product requirements into accessible Angular interfaces with maintainable component boundaries.",
  },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={siteUrl} />

    <!-- Primary meta -->
    <meta name="description" content={description} />
    <meta name="author" content="Akshay Mhatre" />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Akshay Mhatre" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD: Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Akshay Mhatre",
      "url": siteUrl,
      "jobTitle": "Frontend Developer",
      "sameAs": [
        "https://github.com/akshay3001",
        "https://in.linkedin.com/in/akshay-mhatre-732a83144"
      ]
    })} />

    <!-- Google tag (gtag.js) -->
    <script
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-HJJ63FZP1P"
    ></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-HJJ63FZP1P");
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <main id="main-content">
      <header class="masthead" data-testid="header">
        <a class="brand" href="/" aria-label="Akshay Mhatre home">
          <span>AM</span>
        </a>
        <nav class="top-links" aria-label="Social profiles">
          <a
            href="https://github.com/akshay3001"
            target="_blank"
            rel="noopener noreferrer"
            data-testid="github-link"
            aria-label="GitHub profile (opens in new tab)">GitHub</a
          >
          <a
            href="https://in.linkedin.com/in/akshay-mhatre-732a83144"
            target="_blank"
            rel="noopener noreferrer"
            data-testid="linked-link"
            aria-label="LinkedIn profile (opens in new tab)">LinkedIn</a
          >
        </nav>
      </header>

      <section class="hero" aria-labelledby="intro-title">
        <div class="hero-copy">
          <p class="eyebrow">Backbase Certified Frontend Developer</p>
          <h1 id="intro-title" class="name" data-testid="personal-info">
            Akshay Mhatre
          </h1>
          <p class="role">
            I build Angular experiences for digital banking teams shipping across
            retail, business, and wealth management.
          </p>
        </div>

        <aside class="signal-panel" aria-label="Current focus">
          <p class="panel-kicker">Current focus</p>
          <p>
            Shipping reliable frontend journeys on the Backbase AI-powered
            banking platform, from onboarding through long-term servicing.
          </p>
        </aside>
      </section>

      <section class="metrics" aria-label="Experience highlights">
        {
          highlights.map((item) => (
            <article>
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </article>
          ))
        }
      </section>

      <section class="work" aria-labelledby="work-title">
        <div>
          <p class="eyebrow">What I do</p>
          <h2 id="work-title">Frontend work for regulated product teams.</h2>
        </div>
        <p>
          I focus on the parts of banking software where interface quality,
          platform constraints, and product delivery all meet. The work is
          practical: clear flows, resilient components, and screens that can
          survive real release cycles.
        </p>
      </section>

      <section class="capabilities" aria-label="Capabilities">
        {
          capabilities.map((item, index) => (
            <article class="capability">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </section>

      <footer class="footer">
        <p>Available for focused frontend work in banking and platform teams.</p>
        <a href="mailto:akshay3001@gmail.com">akshay3001@gmail.com</a>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #10100e;
    --paper: #f4efe3;
    --ink: #f7f1e6;
    --muted: #aaa093;
    --quiet: #6f685f;
    --line: rgba(244, 239, 227, 0.14);
    --panel: rgba(244, 239, 227, 0.07);
    --accent: #d8a339;
    --accent-strong: #f0bf53;
    --shadow: rgba(0, 0, 0, 0.35);
    --display: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --body: "Avenir Next", Avenir, "Segoe UI", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
  }

  html {
    min-height: 100%;
    background: var(--bg);
  }

  body {
    min-height: 100vh;
    color: var(--ink);
    font-family: var(--body);
    background:
      linear-gradient(135deg, rgba(216, 163, 57, 0.16), transparent 28rem),
      radial-gradient(circle at 88% 12%, rgba(244, 239, 227, 0.1), transparent 18rem),
      linear-gradient(90deg, rgba(244, 239, 227, 0.035) 1px, transparent 1px),
      var(--bg);
    background-size: auto, auto, 88px 88px, auto;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.3;
    background-image:
      linear-gradient(rgba(244, 239, 227, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 239, 227, 0.04) 1px, transparent 1px);
    background-size: 100% 9rem, 9rem 100%;
    mask-image: linear-gradient(to bottom, black, transparent 78%);
  }

  .skip-link {
    position: absolute;
    top: -48px;
    left: 1rem;
    padding: 0.6rem 0.85rem;
    background: var(--paper);
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    z-index: 100;
    transition: top 0.2s ease;
  }

  .skip-link:focus-visible {
    top: 1rem;
  }

  main {
    width: min(1180px, calc(100% - clamp(2rem, 7vw, 7rem)));
    min-height: 100vh;
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2rem) 0 clamp(2rem, 5vw, 4rem);
  }

  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .brand {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--paper);
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0;
    text-decoration: none;
    background: rgba(244, 239, 227, 0.06);
  }

  .top-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
  }

  a {
    color: var(--ink);
    text-decoration: none;
  }

  .top-links a,
  .footer a {
    position: relative;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .top-links a::after,
  .footer a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.4rem;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--accent-strong);
    transition: transform 0.25s ease;
  }

  a:hover {
    color: var(--accent-strong);
  }

  .top-links a:hover::after,
  .footer a:hover::after,
  a:focus-visible::after {
    transform: scaleX(1);
  }

  a:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 0.35rem;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-copy {
    max-width: 58rem;
  }

  .eyebrow,
  .panel-kicker {
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .name {
    max-width: 9ch;
    margin-top: 0.9rem;
    color: var(--paper);
    font-family: var(--display);
    font-size: clamp(4.8rem, 17vw, 13rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: 0;
  }

  .role {
    max-width: 46rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--muted);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    line-height: 1.35;
  }

  .signal-panel {
    position: relative;
    padding: 1.25rem;
    border-top: 1px solid var(--accent);
    background: linear-gradient(180deg, var(--panel), rgba(244, 239, 227, 0.025));
    box-shadow: 0 1.5rem 4rem var(--shadow);
  }

  .signal-panel::before {
    content: "";
    position: absolute;
    top: -1px;
    right: 0;
    width: 36%;
    height: 1px;
    background: var(--paper);
  }

  .signal-panel p:last-child {
    margin-top: 1.25rem;
    color: var(--paper);
    font-family: var(--display);
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    line-height: 1.18;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .metrics article {
    min-height: 10rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-right: 1px solid var(--line);
  }

  .metrics article:last-child {
    border-right: 0;
  }

  .metrics strong {
    display: block;
    color: var(--paper);
    font-family: var(--display);
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 700;
    line-height: 0.95;
  }

  .metrics span {
    display: block;
    max-width: 12rem;
    margin-top: 1rem;
    color: var(--quiet);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.45;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .work {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.8fr);
    gap: clamp(2rem, 7vw, 6rem);
    padding: clamp(4rem, 10vw, 8rem) 0 clamp(2.5rem, 6vw, 5rem);
  }

  .work h2 {
    max-width: 12ch;
    margin-top: 0.75rem;
    color: var(--paper);
    font-family: var(--display);
    font-size: clamp(2.7rem, 7vw, 6.2rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .work > p {
    align-self: end;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.75;
  }

  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .capability {
    min-height: 20rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background:
      linear-gradient(160deg, rgba(244, 239, 227, 0.085), rgba(244, 239, 227, 0.025)),
      var(--bg);
  }

  .capability span {
    color: var(--accent);
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .capability h3 {
    max-width: 9rem;
    margin-top: 4rem;
    color: var(--paper);
    font-family: var(--display);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
  }

  .capability p {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-top: clamp(2rem, 5vw, 4rem);
    color: var(--quiet);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @keyframes reveal-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .masthead,
  .hero-copy,
  .signal-panel,
  .metrics,
  .work,
  .capabilities,
  .footer {
    animation: reveal-up 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-copy { animation-delay: 0.05s; }
  .signal-panel { animation-delay: 0.12s; }
  .metrics { animation-delay: 0.18s; }
  .work { animation-delay: 0.22s; }
  .capabilities { animation-delay: 0.26s; }
  .footer { animation-delay: 0.3s; }

  @media (max-width: 800px) {
    main {
      width: min(100% - 1.25rem, 44rem);
    }

    .masthead {
      padding-bottom: 3.25rem;
    }

    .hero,
    .work {
      grid-template-columns: 1fr;
    }

    .hero {
      align-items: start;
      padding-bottom: 3.5rem;
    }

    .name {
      max-width: 8ch;
      font-size: clamp(4.1rem, 24vw, 7.5rem);
    }

    .metrics,
    .capabilities {
      grid-template-columns: 1fr;
    }

    .metrics article {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .metrics article:last-child {
      border-bottom: 0;
    }

    .capability {
      min-height: 15rem;
    }

    .capability h3 {
      margin-top: 2.5rem;
    }

    .footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .masthead {
      align-items: flex-start;
    }

    .top-links {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.75rem;
    }

    .role {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
